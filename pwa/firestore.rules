rules_version = '2';

// Per-event RBAC (Phases 1–3). Mirrors src/lib/rbac/permissions.ts and
// src/lib/advances/sections.ts — keep in sync.
//
//   approved gate      (token.approved == true)   -> required for all app access (admins exempt)
//   global admin       (token.admin == true)     -> everything
//   global organizer   (token.organizer == true) -> may create events (must also be approved)
//   production director (token.productionDirector == true)
//                                                 -> READ every event subtree (+ the PM
//                        checklist) without membership; grants NO writes and no admin powers
//   production-manager (per-event role)           -> read + write stages/advances + flag
//   department-lead    (per-event role)           -> read + flag; writes the advance/stage-
//                        production sections of its ASSIGNED departments (members.departments)
//   tech               (per-event role)           -> read
//
// Pending/revoked accounts (no `approved` claim) are blocked here, not just in the UI
// (AuthGate). syncUserClaims grants `approved` once an admin approves the account.
// event → stages → advances. Per-event membership covers all of an event's stages.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isOrganizer() {
      return isSignedIn() && request.auth.token.get('organizer', false) == true;
    }

    // Approved-user gate: an account an admin has approved (or an admin itself).
    // Mirrors the UI AuthGate + the `approved` custom claim set by syncUserClaims.
    function isApproved() {
      return isSignedIn() && request.auth.token.get('approved', false) == true;
    }

    function isActiveUser() {
      return isAdmin() || isApproved();
    }

    // ---- Cross-event oversight (planning/archive/feature/EVENT_OVERSIGHT_ROLE_PLAN.md) ----
    // A production director oversees the PMs' work across the whole application, and may or
    // may not be a member of any given event — so this capability cannot be derived from
    // membership.
    //
    // Over the EVENT SUBTREE the claim is strictly READ-ONLY: it widens reads and grants no
    // writes, no admin functions, and no event creation. A director who needs to edit a show
    // is assigned a per-event production-manager role (capabilities are additive).
    //
    // ONE deliberate exception, added 2026-08-10: the GLOBAL contacts directory, where a
    // director may edit and delete any entry (see `match /contacts/{contactId}`). That is a
    // directory-curation power, not event authority — every event write gate below still
    // ignores this claim.
    function isProductionDirector() {
      return isActiveUser() && request.auth.token.get('productionDirector', false) == true;
    }

    // Production coordinator (CREW_TRAVEL_LODGING_PLAN Phase 2): the director's cross-event
    // READ population plus exactly four narrow writes — crew logistics, the crew roster,
    // the contacts directory, and schedule days. canEditEvent NEVER includes this claim:
    // advances, production records, stages, packets, checklists, and quotes stay PM/admin.
    function isProductionCoordinator() {
      return isActiveUser() && request.auth.token.get('productionCoordinator', false) == true;
    }

    // §2.1 #2 (resolved 2026-08-21): the coordinator joins the oversight read population
    // wholesale — one population, not two subtly different ones.
    function canOverseeAllEvents() {
      return isAdmin() || isProductionDirector() || isProductionCoordinator();
    }

    // May browse the app's GLOBAL directories — the contacts directory and the artist document
    // library (planning/ACCESS_SCOPING_PLAN.md decisions 1 and 4). Mirrored by
    // `canBrowseGlobalDirectories` in src/lib/rbac/permissions.ts and in
    // functions/src/lib/auth/authorize.ts.
    //
    // These collections are GLOBAL, so this gate can only see GLOBAL claims: "is this person a
    // PM on some event?" is not expressible here — answering it needs a per-document membership
    // join that runs the wrong direction. That is a property of the data model, not a policy
    // preference, and it is why a PM who needs the directory holds `organizer`.
    //
    // NOT what a crew member needs to reach their own show's people: the per-event roster
    // (`events/{e}/contacts/{a}`) carries denormalized contact details and is member-readable.
    // Deliberately WIDER than the library's curation gate (admin/organizer) below — reading the
    // shelf is not restocking it.
    function canBrowseGlobalDirectories() {
      return isAdmin() || isOrganizer() || isProductionDirector() || isProductionCoordinator();
    }

    function memberPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid);
    }

    function isMember(eventId) {
      return isActiveUser() && exists(memberPath(eventId));
    }

    // Canonical READ gate for everything under an event: oversight capability OR membership.
    // Every event-subtree read rule below uses this — do not inline `isAdmin() || isMember()`.
    function canReadEvent(eventId) {
      return canOverseeAllEvents() || isMember(eventId);
    }

    function hasEventRole(eventId, role) {
      return isMember(eventId) && get(memberPath(eventId)).data.role == role;
    }

    function canEditEvent(eventId) {
      return isAdmin() || hasEventRole(eventId, 'production-manager');
    }

    // The checklist is a PM working surface, NOT a general member surface: leads/techs never
    // see it. A director reads it (it is the clearest signal of whether a PM is on top of a
    // show) but writes stay on canEditEvent.
    function canReadChecklist(eventId) {
      return canOverseeAllEvents() || canEditEvent(eventId);
    }

    // Crew logistics WRITE gate (plan §4.6/§5.2): event editors, plus the coordinator —
    // the one event-scoped write the coordinator claim carries alongside roster/directory/
    // schedule-days below.
    function canManageCrewLogistics(eventId) {
      return canEditEvent(eventId) || isProductionCoordinator();
    }

    // Crew logistics read superset (plan decision 12): everyone who manages, plus the
    // production director read-only (preserving the "director reads every event subtree"
    // contract). Everyone else reads only records carrying their own denormalized userId
    // (the self branch at the match).
    function canViewAllCrewLogistics(eventId) {
      return canManageCrewLogistics(eventId) || isProductionDirector();
    }

    function canFlagEvent(eventId) {
      return isAdmin()
        || hasEventRole(eventId, 'production-manager')
        || hasEventRole(eventId, 'department-lead');
    }

    // ---- Department-scoped editing (Team & access) ----
    // A department-lead may edit the advance / stage-production SECTIONS of their assigned
    // departments (`members/{uid}.departments`, written by the assignEventMember callable)
    // and nothing else. Mirrors canEditDepartment in src/lib/rbac/permissions.ts.
    function assignedDepts(eventId) {
      return get(memberPath(eventId)).data.get('departments', []);
    }
    // Update-only: the write touches ONLY the section maps (+ updatedAt), and every changed
    // department key — in both `content` and `sections` — is an assigned department. All
    // other fields (artistName, createdBy, googleCalendarEventId, …) are excluded by the
    // top-level key allowlist, so the PM branch's immutability pins aren't needed here.
    function isDeptSectionUpdate(eventId) {
      return hasEventRole(eventId, 'department-lead')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'sections', 'updatedAt'])
        && request.resource.data.get('content', {})
            .diff(resource.data.get('content', {}))
            .affectedKeys().hasOnly(assignedDepts(eventId))
        && request.resource.data.get('sections', {})
            .diff(resource.data.get('sections', {}))
            .affectedKeys().hasOnly(assignedDepts(eventId));
    }
    // Create (the first write to a not-yet-created stage-production record): same key
    // discipline, on the raw keys — there is no `resource` to diff against.
    function isDeptSectionCreate(eventId) {
      return hasEventRole(eventId, 'department-lead')
        && request.resource.data.keys().hasOnly(['content', 'sections', 'updatedAt'])
        && request.resource.data.get('content', {}).keys().hasOnly(assignedDepts(eventId))
        && request.resource.data.get('sections', {}).keys().hasOnly(assignedDepts(eventId));
    }

    // ---- Document shape validators (mirror the client Zod parsers in src/lib/*) ----
    // `.get(key, default)` keeps these absent-safe: a missing key yields the default
    // (and fails the check) instead of raising an evaluation error.
    // NOTE: rules can't iterate arrays/maps, so per-element shape — quote
    // lineItems[].quantity/unitPrice >= 0 and advance sections.*.status — is NOT
    // enforced here; the client Zod parsers (and, later, callable schemas) own it.
    function nonEmptyStr(data, key) {
      return data.get(key, '') is string && data.get(key, '').size() > 0;
    }
    function fieldIn(data, key, allowed) {
      return data.get(key, '') in allowed;
    }
    // True if none of `keys` changed between the stored and incoming doc (immutable /
    // server-owned fields). Update-only — there is no `resource` on create.
    function keysUnchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // App-wide department list: any approved user reads; admin manages.
    match /departments/{deptId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // App-wide festival list (name + logo): any approved user reads; admin manages.
    match /festivals/{festivalId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // App-wide document category list: any approved user reads; admin manages.
    match /documentCategories/{categoryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Artist document library: a CROSS-EVENT surface since 2026-09-03 — only the global
    // capabilities browse it (planning/ACCESS_SCOPING_PLAN.md decision 4); admin/organizer
    // classify, delete, and record their own uploads (doc id = the Drive file id; audit field
    // pinned). Bulk creation stays server-side (importDriveFolder, Admin SDK).
    //
    // An event member still OPENS a library file included on one of their advances — that runs
    // through the `getArtistDocumentContent` broker, which checks the inclusion record
    // server-side (Admin SDK, rules-exempt). Narrowing this read without that check would have
    // left the file bytes reachable; the two shipped together.
    match /artistDocuments/{docId} {
      allow read: if canBrowseGlobalDirectories();
      // Server-only (S8): registered by the registerArtistDocument callable (Admin SDK), which
      // verifies the file's Drive provenance under the library root first (F-1). No client create.
      allow create: if false;
      // Curation only: admin/organizer may (re)classify + annotate (categoryId, displayName, notes,
      // obsolete, verifiedAt). The trusted Drive source metadata the callable recorded is immutable
      // to clients (F-3/WS-A) — else a client could repoint name/link/mime to a file it never proved
      // provenance for. Relinking is server-only (re-register via the callable).
      allow update: if isActiveUser() && (isAdmin() || isOrganizer())
        && keysUnchanged(['fileId', 'name', 'mimeType', 'iconLink', 'webViewLink',
                          'artist', 'artistKey', 'sourceFolderId',
                          'importedBy', 'importedByEmail', 'importedAt']);
      allow delete: if isActiveUser() && (isAdmin() || isOrganizer());
    }

    // Event templates (blueprints): any approved user reads (event-create picker);
    // admin authors. Cloning runs server-side (createEventFromTemplate, Admin SDK).
    match /templates/{templateId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Reusable schedule templates (day-first blueprints): any approved user reads (import
    // picker); admin/organizer author. Applying one seeds events/{e}/scheduleDays (gated there).
    match /scheduleTemplates/{templateId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() && (isAdmin() || isOrganizer());
    }

    // Event-checklist templates: any approved user reads (PMs import them onto their
    // events); admin manages (the admin Event-setup tab).
    match /checklistTemplates/{templateId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // App-level branding config (config/branding): shared default logo marks. Any approved user reads; admin manages.
    match /config/{configId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Global contact directory (ROADMAP §11): reference data, distinct from RBAC users.
    // Any approved member ADDS; the creator (or admin) edits/deletes. A user may also update
    // the entry linked to their own account (userId == them) — e.g. their profile photo.
    //
    // READ narrowed 2026-09-03 (planning/ACCESS_SCOPING_PLAN.md decision 1): this is the whole
    // cross-company directory — every name, phone, email and note — and it was readable by
    // every approved account, including techs auto-enrolled by a crew attachment. Now only the
    // global capabilities browse it. Two things depend on that being survivable, both shipped
    // first (PR 1):
    //   1. Crew see their own show's people from the DENORMALIZED copies on
    //      `events/{e}/contacts/{a}`, which are member-readable. Nothing here resolves them.
    //   2. Everyone keeps reading the entry linked to their OWN account — the second clause —
    //      which is how Settings saves a profile photo. It is query-shaped on purpose: it
    //      authorizes `where('userId','==',uid)` and per-doc reads of your own mirror, and
    //      nothing wider. A directory-wide list still needs the capability.
    match /contacts/{contactId} {
      allow read: if canBrowseGlobalDirectories()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      // `userId` links a contact to an account (profile mirror). A client may only create an
      // unlinked contact or one linked to THEMSELVES — never spoof a link to another account.
      // The server-created self-mirror (syncUserClaims, Admin SDK) bypasses these rules.
      allow create: if isActiveUser()
        && request.resource.data.createdBy == request.auth.uid
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
      // Ordinary clients (the creator, or a user linked via userId — e.g. editing their own
      // profile photo) may update, but NOT rewrite the ownership/link fields: `createdBy` and
      // `userId` are immutable to them (F-3). Otherwise a linked user could seize `createdBy`
      // and then satisfy the creator-only delete.
      // A production director curates the whole directory (decision 2026-08-10) — they may
      // edit and delete ANY entry, not only their own.
      // `userId` is now DENORMALIZED authorization data: crewLogistics records copy it and
      // gate reads of room numbers / confirmation codes on the copy
      // (planning/archive/feature/CREW_TRAVEL_LODGING_PLAN.md §4.2). So since 2026-08-20 the link fields are
      // immutable through EVERY direct client write, including an admin's — a one-write client
      // relink would leave the copies authorizing the wrong account. Admin relinking is not
      // lost (decision 13): it moved to the admin-only `relinkContactUser` callable, which
      // updates the contact, both users/{uid} pointers, and every denormalized copy in one
      // transaction. Sign-in/delete keep their Admin-SDK link/unlink paths (rules-exempt).
      allow update: if (isAdmin()
        || (isActiveUser()
            && (isProductionDirector()
                || isProductionCoordinator()
                || resource.data.createdBy == request.auth.uid
                || resource.data.userId == request.auth.uid)))
        && keysUnchanged(['createdBy', 'userId']);
      allow delete: if isAdmin()
        || (isActiveUser()
            && (isProductionDirector()
                || isProductionCoordinator()
                || resource.data.createdBy == request.auth.uid));
    }

    // User profiles are server-managed (Admin SDK). Self/admin read; no client write.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Google connection STATUS (Phase 11b) — non-secret mirror written by the Admin SDK
    // (OAuth callback). Owner or admin reads to render connect/disconnect UI; no client
    // write. Refresh/access tokens live in googleTokens/{uid} (server-only, below).
    match /googleConnections/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // OAuth refresh/access tokens and the single-use CSRF state — Admin SDK only,
    // never client-readable or client-writable.
    match /googleTokens/{uid} {
      allow read, write: if false;
    }
    match /googleOAuthStates/{stateId} {
      allow read, write: if false;
    }
    // Distributed rate-limit counters — written only by the Admin SDK (bypasses rules).
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
    // Calendar feed bearer-token lookup (doc id = sha256 of the token) and the
    // one-active-feed pointer — Admin SDK only, never client-readable or -writable
    // (status flows through the getCalendarFeedStatus callable).
    match /calendarFeeds/{tokenHash} {
      allow read, write: if false;
    }
    match /calendarFeedOwners/{uid} {
      allow read, write: if false;
    }
    // Calendar feed preferences (Phase 2) — owner reads; every write goes through the
    // validated updateCalendarSubscription callable (Admin SDK), which owns the field
    // allowlist, array bounds, and `updatedAt`.
    match /calendarSubscriptions/{uid} {
      allow read: if isActiveUser() && request.auth.uid == uid;
      allow write: if false;
    }

    // Canonical event-slug reservations (WS-G): doc id = the slug, body `{ eventId }`. The
    // uniqueness lock behind event URLs — claimed/released ONLY by the Admin SDK (createBlankEvent,
    // createEventFromTemplate, renameEventSlug), which bypasses these rules. Never client-touchable;
    // slug resolution (getEventBySlugOrId) queries the events collection, not this one.
    match /slugs/{slug} {
      allow read, write: if false;
    }

    // Collection-group read for the non-admin events-list query
    // (`collectionGroup('members').where('uid','==', me)` in events-service.listEvents):
    // a signed-in user may list their OWN membership rows across every event, and no one
    // else's. collectionGroup() queries only match a `/{path=**}/` rule, so this must live
    // at the top level; direct member-doc access + all writes stay on the nested
    // events/{eventId}/members rule below. Read-only — writes are unaffected.
    //
    // DELIBERATELY NOT WIDENED for cross-event oversight (canOverseeAllEvents). This rule is
    // the ONE unscoped, application-wide collection-group surface, and keeping it self-only is
    // what makes "which events am I on?" safe: it cannot be turned into "dump every user's
    // membership row across every event". A director reads a KNOWN event's roster through the
    // nested events/{eventId}/members rule instead, which is scoped to one event at a time.
    match /{path=**}/members/{memberUid} {
      allow read: if isActiveUser() && request.auth.uid == resource.data.uid;
    }

    match /events/{eventId} {
      allow read: if canReadEvent(eventId);
      // Server-only (S8): events are created atomically with the creator's PM membership by the
      // createBlankEvent / createEventFromTemplate callables (Admin SDK), so an event can never
      // exist without its membership (WS-G). No client create.
      allow create: if false;
      allow update: if canEditEvent(eventId)
        && request.resource.data.createdBy == resource.data.createdBy // owner immutable
        && nonEmptyStr(request.resource.data, 'name')
        && fieldIn(request.resource.data, 'status', ['draft', 'active', 'archived'])
        // Server-owned: renameEventSlug transactionally moves the canonical
        // slugs/{slug} reservation.
        && keysUnchanged(['slug']);
      allow delete: if isAdmin();

      // Membership: admin-managed, OR the event's creator bootstrapping as PM.
      // NOTE: this nested rule governs DIRECT member-doc access (roster read, writes).
      // The non-admin events-list *collection-group* query is authorized separately by
      // the `/{path=**}/members` rule at the top of this service — nested rules do not
      // apply to collectionGroup() queries.
      match /members/{memberUid} {
        // Not the uniform event-read shape: it also lets any active user read their OWN row
        // (that self-clause is what the events-list collection-group query below relies on).
        allow read: if canReadEvent(eventId)
          || (isActiveUser() && request.auth.uid == memberUid);
        // Admin adds members; the creator's own PM membership is created server-side by the
        // createBlankEvent callable (Admin SDK) — NOT client self-bootstrap — so a removed creator
        // can't recreate a PM membership (WS-B, S8).
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }

      // Stages: members read; PM/admin write.
      match /stages/{stageId} {
        allow read: if canReadEvent(eventId);
        allow create, update, delete: if canEditEvent(eventId);

        // Advances live under a stage. Member read; PM/admin write (section
        // finalize/unlock ride the update gate, so tech/dept-lead can't change status).
        match /advances/{advanceId} {
          // Calendar linkage is server-owned: attachCallBooking atomically updates it, and
          // createAdvanceCall writes it through the Admin SDK. Ordinary creates start unlinked.
          allow read: if canReadEvent(eventId);
          allow create: if canEditEvent(eventId)
            && request.resource.data.createdBy == request.auth.uid
            && nonEmptyStr(request.resource.data, 'artistName')
            && !request.resource.data.keys().hasAny(['googleCalendarEventId']);
          allow update: if (canEditEvent(eventId)
            && request.resource.data.createdBy == resource.data.createdBy // owner immutable
            && nonEmptyStr(request.resource.data, 'artistName')
            && keysUnchanged(['googleCalendarEventId']))
            // Department editor: their assigned departments' content/sections only.
            || isDeptSectionUpdate(eventId);
          allow delete: if canEditEvent(eventId);

          // Linked Google Drive files — server-written only (link/removeDriveFile
          // callables; the Admin SDK bypasses rules). Members read; no client write.
          match /driveFiles/{fileId} {
            allow read: if canReadEvent(eventId);
            allow write: if false;
          }

          // Included artist documents (Documents PR 3): per-advance curation of the
          // library — doc id = the artistDocuments id. Members read; advance editors
          // (admin / event PM) curate. `includePacket` rides the update gate for the
          // packet-embedding PR; the audit fields stay immutable.
          match /documents/{docId} {
            allow read: if canReadEvent(eventId);
            // Server-only (S8): included via the includeArtistDocumentOnAdvance callable (Admin
            // SDK), which copies the canonical artistDocuments metadata (F-1). No client create.
            allow create: if false;
            // Only `includePacket` (packet-embed toggle) is client-editable curation; the audit
            // fields AND the copied Drive source metadata are immutable to clients (F-3/WS-A).
            allow update: if canEditEvent(eventId)
              && keysUnchanged(['fileId', 'name', 'mimeType', 'iconLink', 'webViewLink',
                                'addedBy', 'addedAt']);
            allow delete: if canEditEvent(eventId);
          }

          // Quotes/estimates (artist-covered expenses): member read; PM/admin author + decide.
          // Status changes (approve/reject) ride the update gate, so tech/dept-lead can't decide.
          match /quotes/{quoteId} {
            allow read: if canReadEvent(eventId);
            allow create: if canEditEvent(eventId)
              && request.resource.data.createdBy == request.auth.uid
              && nonEmptyStr(request.resource.data, 'title')
              && fieldIn(request.resource.data, 'status', ['draft', 'sent', 'approved', 'rejected']);
            allow update: if canEditEvent(eventId)
              && request.resource.data.createdBy == resource.data.createdBy // owner immutable
              && nonEmptyStr(request.resource.data, 'title')
              && fieldIn(request.resource.data, 'status', ['draft', 'sent', 'approved', 'rejected']);
            allow delete: if canEditEvent(eventId);
          }
        }

        // Per-stage technical production record (house package): member read; PM/admin
        // write; a department-lead writes their assigned departments' sections (the
        // create branch covers the merge-write that first materializes the record).
        match /production/{recordId} {
          allow read: if canReadEvent(eventId);
          allow create: if canEditEvent(eventId) || isDeptSectionCreate(eventId);
          allow update: if canEditEvent(eventId) || isDeptSectionUpdate(eventId);
          allow delete: if canEditEvent(eventId);

          // Attachments (stage plots / CAD / maps) — one doc per file; member read, PM/admin write.
          match /attachments/{attachId} {
            allow read: if canReadEvent(eventId);
            allow write: if canEditEvent(eventId);
          }
        }
      }

      // Event-level production record (general/tech-operational): member read; PM/admin write.
      match /production/{recordId} {
        allow read: if canReadEvent(eventId);
        allow write: if canEditEvent(eventId);

        // Attachments (plots / CAD / maps) — one doc per file; member read, PM/admin write.
        match /attachments/{attachId} {
          allow read: if canReadEvent(eventId);
          allow write: if canEditEvent(eventId);
        }
      }

      // Per-event contact attachments (join → global contacts/{id}): member read; PM/admin
      // create/update. DELETE is server-only since 2026-08-20: crewLogistics records reference
      // an attachment by id, rules cannot query for those dependents, and a silent orphan is
      // not acceptable — the `detachEventContact` callable (Admin SDK) refuses the detach
      // while any logistics record references the attachment.
      match /contacts/{attachId} {
        allow read: if canReadEvent(eventId);
        // Coordinator (Phase 2): roster curation is one of the claim's four writes. The Tech
        // auto-enroll this can trigger is authorized server-side as exactly role=tech +
        // ifAbsent (members.ts) — the claim cannot assign or alter memberships.
        allow create, update: if canEditEvent(eventId) || isProductionCoordinator();
        allow delete: if false;
      }

      // Crew travel & lodging (planning/archive/feature/CREW_TRAVEL_LODGING_PLAN.md §4.3): per-person records
      // holding room numbers and confirmation codes, so the read boundary is DELIBERATELY
      // narrower than canReadEvent — event editors and the production director see all; an
      // ordinary member sees only records carrying their own denormalized userId. The self
      // branch requires isMember so a pending/revoked matching account, or an approved
      // non-member, is still denied. NOTE the list-query trap: clients must issue the
      // uid-constrained query unless they satisfy canViewAllCrewLogistics.
      match /crewLogistics/{recordId} {
        // The record's three identity fields are server-verifiable, not client assertions:
        // the attachment must exist on THIS event's roster, name the same directory contact,
        // and the denormalized userId must equal that contact's CURRENT link (absent → null).
        function attachmentPath() {
          return /databases/$(database)/documents/events/$(eventId)/contacts/$(request.resource.data.eventContactId);
        }
        function linkedContact() {
          return get(/databases/$(database)/documents/contacts/$(request.resource.data.contactId));
        }
        function identityProven() {
          return exists(attachmentPath())
            && get(attachmentPath()).data.contactId == request.resource.data.contactId
            && request.resource.data.get('userId', null) == linkedContact().data.get('userId', null);
        }
        // Discriminated shape: exactly the keys of one kind, nothing unknown (the client Zod
        // parser owns finer validation — value types, real dates, IANA zones).
        function lodgingShape() {
          return request.resource.data.kind == 'lodging'
            && request.resource.data.keys().hasOnly(['kind', 'eventContactId', 'contactId',
                 'userId', 'notes', 'createdBy', 'createdAt', 'updatedAt', 'hotelName',
                 'address', 'hotelPhone', 'confirmation', 'checkInDate', 'checkOutDate',
                 'roomType', 'roomNumber'])
            && nonEmptyStr(request.resource.data, 'hotelName')
            && request.resource.data.get('checkInDate', '').matches('\\d{4}-\\d{2}-\\d{2}')
            && request.resource.data.get('checkOutDate', '').matches('\\d{4}-\\d{2}-\\d{2}')
            && request.resource.data.checkOutDate >= request.resource.data.checkInDate;
        }
        function travelShape() {
          return request.resource.data.kind == 'travel'
            && request.resource.data.keys().hasOnly(['kind', 'eventContactId', 'contactId',
                 'userId', 'notes', 'createdBy', 'createdAt', 'updatedAt', 'mode', 'carrier',
                 'confirmation', 'from', 'to', 'departAt', 'arriveAt', 'departTimeZone',
                 'arriveTimeZone'])
            && fieldIn(request.resource.data, 'mode', ['flight', 'drive', 'train', 'other'])
            && (request.resource.data.get('departAt', null) == null
                || nonEmptyStr(request.resource.data, 'departTimeZone'))
            && (request.resource.data.get('arriveAt', null) == null
                || nonEmptyStr(request.resource.data, 'arriveTimeZone'));
        }
        function validCrewLogisticsWrite() {
          return identityProven() && (lodgingShape() || travelShape());
        }

        allow read: if canViewAllCrewLogistics(eventId)
          || (isMember(eventId) && resource.data.userId == request.auth.uid);
        allow create: if canManageCrewLogistics(eventId) && validCrewLogisticsWrite()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageCrewLogistics(eventId) && validCrewLogisticsWrite()
          && keysUnchanged(['createdBy', 'createdAt']);
        allow delete: if canManageCrewLogistics(eventId);
      }

      // Event checklist: a PM-only working surface — READ requires canEditEvent (or the
      // cross-event oversight capability), so department leads / techs never see it
      // (decision 2026-08-03). Writes stay PM/admin: a director reads but never edits.
      // `completedAt` doubles as the done flag (null = not done) and is client-set: the
      // completion time is deliberately user-editable. Not part of the advance tracker.
      match /checklist/{itemId} {
        allow read: if canReadChecklist(eventId);
        allow create, update: if canEditEvent(eventId)
          && nonEmptyStr(request.resource.data, 'text')
          && fieldIn(request.resource.data, 'section', ['main', 'post-show']);
        allow delete: if canEditEvent(eventId);
      }

      // Event documents (Documents PR 4): Drive files in the event's linked folder,
      // recorded per event and grouped by schedule day key. Doc id = the Drive file id.
      // Members read; PM/admin manage. Audit fields pinned + immutable.
      match /documents/{docId} {
        allow read: if canReadEvent(eventId);
        // Server-only (S8): registered by the registerEventDocument callable (Admin SDK), which
        // verifies the file lives in the event's linked Drive folder (F-1). No client create.
        allow create: if false;
        // Client curation is limited to day / categoryId / displayName; the audit fields AND the
        // Drive source metadata the callable recorded are immutable to clients (F-3/WS-A).
        allow update: if canEditEvent(eventId)
          && keysUnchanged(['fileId', 'name', 'mimeType', 'iconLink', 'webViewLink',
                            'uploadedBy', 'uploadedAt']);
        allow delete: if canEditEvent(eventId);
      }

      // Schedule days (redesign — planning/archive/feature/SCHEDULE_REDESIGN.md): one doc per calendar day,
      // doc id = the 'YYYY-MM-DD' date key (one-card-per-date is structural), items embedded
      // in the day. Member read; PM/admin write. (Rules can't practically gate fields inside
      // an embedded array; the client Zod parser owns per-item shape.)
      match /scheduleDays/{dayKey} {
        // Coordinator (Phase 2, CREW_TRAVEL_LODGING_PLAN §5.2): schedule days are one of the
        // claim's four writes — arrival times they book land on the timeline directly.
        // validDayShape, createdBy pinning, and the revision counter all still bind.
        function canManageScheduleDays() {
          return canEditEvent(eventId) || isProductionCoordinator();
        }
        // Shared shape gate for create + update: the stored date always equals the doc
        // id, the day type is a known key, and items is a (possibly empty) list.
        function validDayShape() {
          return request.resource.data.get('date', '') == dayKey
            && fieldIn(request.resource.data, 'dayType', ['travel', 'loadIn', 'show', 'loadOut', 'offDay'])
            && request.resource.data.get('items', []) is list;
        }
        allow read: if canReadEvent(eventId);
        allow create: if canManageScheduleDays()
          && validDayShape()
          && dayKey.matches('\\d{4}-\\d{2}-\\d{2}')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.revision is int
          && request.resource.data.revision == 0;
        allow update: if canManageScheduleDays()
          && validDayShape()
          && keysUnchanged(['createdBy'])
          // Every client update increments the optimistic-concurrency counter. Legacy docs without
          // a counter start at zero; Admin-SDK calendar reconciliation bypasses rules.
          && request.resource.data.revision is int
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
        allow delete: if canManageScheduleDays();
      }

      // Booked advance-call inbox: sync + attach are Admin-SDK operations. A PM/admin client may
      // only dismiss an unresolved entry; it cannot forge, attach, reopen, or delete bookings.
      match /callBookings/{bookingId} {
        allow read: if canReadEvent(eventId);
        allow create, delete: if false;
        allow update: if canEditEvent(eventId)
          && resource.data.status == 'needs_review'
          && request.resource.data.status == 'dismissed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      }

      // Flags/comments (event-level): PM + dept-lead (+ admin) author; authors modify own.
      match /flags/{flagId} {
        allow read: if canReadEvent(eventId);
        allow create: if canFlagEvent(eventId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.createdBy == request.auth.uid && canFlagEvent(eventId));
      }
    }
  }
}
